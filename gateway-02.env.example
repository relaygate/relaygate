# gateway-02 双活数据面节点示例（复制到该主机仓库根目录为 .env）
# cp gateway-02.env.example .env && chmod 600 .env
#
# 建议：不启用 Panel（systemd）/ 本地 Grafana（由 gateway-01 或集中监控承担管理面）
# 配置源仍是同一份 GitOps 下发的 resources.yaml（运行态 DataDir，非源码树）

GATEWAY_NAME=gateway-02
GATEWAY_PUBLIC_IP=203.0.113.20
# SSH 端口：安装/配置时指定，默认 22
GATEWAY_SSH_PORT=22
# standby = 勿启 Panel（ENABLE_PANEL=0）；若误启则 Panel 拒绝写操作
PANEL_ROLE=standby
ENABLE_PANEL=0
COMPOSE_PROJECT_NAME=relaygate-gateway-02
# 空 = 仅 envoy + prometheus + node_exporter
COMPOSE_PROFILES=with-logs

ENVOY_IMAGE=envoyproxy/envoy:v1.39.0
ENVOY_ADMIN_PORT=9901
ENVOY_CONCURRENCY=0

IMAGE_TAG=local

# Grafana/Panel 密码在无对应组件时仍可占位；生产勿依赖 .env 明文
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=unused-on-standby
PANEL_ADMIN_PASSWORD=unused-on-standby
PANEL_BIND=127.0.0.1:9000
# 未启 Panel/Grafana 时显式关闭反代目标
GRAFANA_URL=

PROMETHEUS_RETENTION=7d
# PROMETHEUS_REMOTE_WRITE_URL=http://prometheus.internal:9090/api/v1/write

# 边缘日志采集 → 中心 Loki（勿对公网暴露 3100）
# LOKI_HOST=10.0.0.1
# LOKI_PORT=3100
# LOG_SAMPLE_RATE=1.0
# LOG_SHORT_SESSION_MS=2000

