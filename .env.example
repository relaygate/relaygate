# 复制为服务器上的 .env（权限 600），不要提交真实密码
# cp .env.example .env && chmod 600 .env
#
# 双活部署：每台网关各自一份 .env（可参考 gateway-0N.env.example）
# 同一套 packaging/compose.yaml 可复用；日常运维用 relaygate CLI。
# 运行态：开发默认 <repo>/.runtime；安装默认 $INSTALL_DIR/data。
# setup 会写入绝对路径 RELAYGATE_DATA_DIR=…（compose 挂载依赖此变量）。
# --- 本机网关身份（必填，驱动容器名 / Envoy node / Prometheus 标签）---
GATEWAY_NAME=gateway-01
GATEWAY_PUBLIC_IP=203.0.113.10
# SSH 端口：安装/配置时指定，默认 22
GATEWAY_SSH_PORT=22
# primary=可写；standby=写保护（拒绝 API/表单写）；双活从节点请 ENABLE_PANEL=0
PANEL_ROLE=primary
# 安装器/运维标记：1=宿主二进制 + systemd（relaygate-panel）；0=不装 Panel
ENABLE_PANEL=1

# Compose 项目名（避免多机同名冲突；默认可等于 GATEWAY_NAME）
COMPOSE_PROJECT_NAME=relaygate-gateway-01

# Compose 仅管数据面可选组件。主管理节点推荐 with-grafana；从节点留空。
# Panel 不在 Compose 中（勿再写 with-panel）。
COMPOSE_PROFILES=with-grafana,with-loki,with-logs

ENVOY_IMAGE=envoyproxy/envoy:v1.39.0
ENVOY_ADMIN_PORT=9901
# 0 = Envoy 自动按 CPU 核数设置 worker
ENVOY_CONCURRENCY=0

# 构建提取二进制时使用的不可变 tag（git SHA）；禁止生产 latest
IMAGE_TAG=local

# Grafana / Panel 密码：以下仅供本地开发兼容。
# 一键安装使用 RELAYGATE_SECRETS_DIR 下的文件，不把密码写入 .env。
# grafana_admin_password 文件权限须为 0640（Grafana 容器 gid=0 可读；勿用 0600）。
# 密码仅写入 RELAYGATE_SECRETS_DIR/grafana_admin_password（setup 生成），勿在 .env 设置 GF_* 密码。
RELAYGATE_SECRETS_DIR=/etc/relaygate/secrets
GRAFANA_ADMIN_USER=admin

# 本地开发可设 PANEL_ADMIN_PASSWORD；生产用 PANEL_ADMIN_PASSWORD_FILE（systemd）
PANEL_ADMIN_PASSWORD=change-me-panel-password
PANEL_BIND=127.0.0.1:9000

# Grafana 仅经 Panel 同源反代（/grafana/、/monitoring）；Panel 为唯一管理出口。
# 置空 GRAFANA_URL= 可关闭反代（如从节点）。Panel 仅接受 loopback 的 http(s) URL。
GRAFANA_URL=http://127.0.0.1:3000
# root_url：相对子路径兼容 SSH 隧道（浏览器 origin 为 localhost:9000）。
# 官方模板 %(protocol)s://%(domain)s:%(http_port)s/grafana/ 中的 http_port 是 Grafana
# 自身监听端口（3000），经 Panel 反代时请勿用作默认，否则会链到不可达的 :3000。
GRAFANA_ROOT_URL=/grafana/
GRAFANA_ANONYMOUS=true

# L4 友好变更：reload / drain fail 等待 LB 摘流窗口（秒）。
# 与 packaging/terraform/nlb 默认 HC 对齐：unhealthy_threshold(3) × interval(10s) = 30。
# 若自建 NLB 改了 threshold/interval，请同步调大本值（建议 ≥ 乘积）。
DRAIN_WAIT=30


# --- TCP access 日志（Fluent Bit → Loki）见 docs/logging-playbook.md ---
# 主节点：上列 profiles 含 with-loki,with-logs；从节点：COMPOSE_PROFILES=with-logs
# LOKI_HOST=127.0.0.1
# LOKI_PORT=3100
# LOKI_IMAGE=grafana/loki:3.5.0
# FLUENT_BIT_IMAGE=fluent/fluent-bit:3.2.10
# 保留期与 packaging/loki/loki-config.yml retention_period 对齐（改配置后重启 Loki）
# LOKI_RETENTION_PERIOD=168h
# P2 采样：1.0=全量；<1 时仅对「正常」会话抽样；flags≠- 与短会话始终保留
# LOG_SAMPLE_RATE=1.0
# LOG_SHORT_SESSION_MS=2000
PROMETHEUS_RETENTION=15d
# 可选：边缘 Prometheus remote_write 到集中监控
# PROMETHEUS_REMOTE_WRITE_URL=http://prometheus.internal:9090/api/v1/write
