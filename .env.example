# 复制为服务器上的 .env（权限 600），不要提交真实密码
# cp .env.example .env && chmod 600 .env
#
# 双活部署：每台网关各自一份 .env（可参考 deploy/env/gateway-0N.env.example）
# 同一套 deploy/compose.yaml / scripts 可复用。

# --- 本机网关身份（必填，驱动容器名 / Envoy node / Prometheus 标签）---
GATEWAY_NAME=gateway-01
GATEWAY_PUBLIC_IP=107.149.191.37
GATEWAY_SSH_PORT=30455
# 运维约定标记（Panel 进程不读）：primary=可开 Panel；standby=不跑 Panel（COMPOSE_PROFILES 去掉 with-panel）
PANEL_ROLE=primary

# Compose 项目名（避免多机同名冲突；默认可等于 GATEWAY_NAME）
COMPOSE_PROJECT_NAME=relaygate-gateway-01

# 启用本地 Panel + Grafana（主管理节点推荐）
# 从节点示例: COMPOSE_PROFILES=
COMPOSE_PROFILES=with-panel,with-grafana

ENVOY_IMAGE=envoyproxy/envoy:v1.39.0
ENVOY_ADMIN_PORT=9901
# 0 = Envoy 自动按 CPU 核数设置 worker
ENVOY_CONCURRENCY=0

# Panel 镜像（生产请用不可变 tag，例如 git SHA；禁止 latest）
PANEL_IMAGE=relaygate-panel
IMAGE_TAG=local

# Grafana / Panel 密码：本地开发可用本文件；生产请从密钥管理注入（勿提交真实值）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password

PANEL_ADMIN_PASSWORD=change-me-panel-password
PANEL_BIND=127.0.0.1:8080

PROMETHEUS_RETENTION=15d
# 可选：边缘 Prometheus remote_write 到集中监控
# PROMETHEUS_REMOTE_WRITE_URL=http://monitoring.internal:9090/api/v1/write
