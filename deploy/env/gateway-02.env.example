# gateway-02 双活数据面节点示例（复制到该主机仓库根目录为 .env）
# cp deploy/env/gateway-02.env.example .env && chmod 600 .env
#
# 建议：不启用 Panel / 本地 Grafana（由 gateway-01 或集中监控承担管理面）
# 配置源仍是同一份 Git 中的 config/resources.yaml（GitOps 分批下发）

GATEWAY_NAME=gateway-02
GATEWAY_PUBLIC_IP=203.0.113.20
GATEWAY_SSH_PORT=30455
# 运维约定（Panel 不读）：standby = 勿开 with-panel，防双写
PANEL_ROLE=standby
COMPOSE_PROJECT_NAME=relaygate-gateway-02
# 空 = 仅 envoy + prometheus + node_exporter
COMPOSE_PROFILES=

ENVOY_IMAGE=envoyproxy/envoy:v1.39.0
ENVOY_ADMIN_PORT=9901
ENVOY_CONCURRENCY=0

PANEL_IMAGE=relaygate-panel
IMAGE_TAG=local

# Grafana/Panel 密码在无对应 profile 时仍可占位，满足 compose 插值校验
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=unused-on-standby
PANEL_ADMIN_PASSWORD=unused-on-standby
PANEL_BIND=127.0.0.1:8080

PROMETHEUS_RETENTION=7d
# PROMETHEUS_REMOTE_WRITE_URL=http://monitoring.internal:9090/api/v1/write
