# 运维机 / CI 使用的网关 inventory（勿提交真实生产密钥；主机名/IP 可按环境填写）
# cp deploy/inventory/gateways.env.example deploy/inventory/gateways.env

GATEWAY_MATRIX=gateway-01,gateway-02

# gateway-01（主管理节点，跑 Panel）
HOST_gateway_01=107.149.191.37
SSH_PORT_gateway_01=30455
SSH_USER_gateway_01=root
REMOTE_DIR_gateway_01=/opt/relaygate

# gateway-02（双活数据面）
HOST_gateway_02=203.0.113.20
SSH_PORT_gateway_02=30455
SSH_USER_gateway_02=root
REMOTE_DIR_gateway_02=/opt/relaygate

