#!/usr/sbin/nft -f
# RelayGate 网关防火墙模板（版本化，随 packaging 发布）
# 勿直接 nft -f 本文件：SSH 端口与 include 路径由 `relaygate firewall` 改写后
# 写入 DataDir/firewall/.gateway-*.nft 再校验/应用。
# 端口定义、限速与 ACL 集合由 render 生成：DataDir/firewall/forward-ports.nft
# （FORWARD_*_PORTS / FORWARD_*_RATE/BURST / ACL_DENY|ALLOW — 防火墙集合，非「转发规则」）
# 转发规则真相源仍是 resources.yaml rules[]；此处只消费其启用端口与 acl。
#
# 警告：错误应用可能导致 SSH 断开。请保留现有会话并准备控制台。

flush ruleset

# 占位 include；firewall/apply 会改写为 DataDir/firewall/forward-ports.nft 的绝对路径
include "forward-ports.nft"

define SSH_PORT = 22
# 可选：限制管理面来源（示例，按需取消注释并修改）
# define OPS_IPV4 = { 203.0.113.10 }

table inet relaygate {
  set tcp_new_per_ip {
    type ipv4_addr
    flags dynamic
    size 65535
  }
  set udp_pps_per_ip {
    type ipv4_addr
    flags dynamic
    size 65535
  }

  chain input {
    type filter hook input priority filter; policy drop;

    # 基础
    ct state established,related accept
    iifname "lo" accept
    ct state invalid drop

    # ICMP / ICMPv6（排障）
    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept

    # SSH 运维入口（必须保留；不受业务 ACL 约束）
    tcp dport $SSH_PORT ct state new limit rate 10/second burst 20 packets accept comment "allow-ops-ssh"

    # Panel 管理面（INPUT；默认 PANEL_BIND=0.0.0.0:9000 对外监听，与此放行配套）
    # 可选来源限制：取消上方 OPS_IPV4 注释后改为
    #   tcp dport 9000 ip saddr $OPS_IPV4 ct state new limit rate 20/second burst 40 packets accept
    tcp dport 9000 ct state new limit rate 20/second burst 40 packets accept comment "allow-panel"

    # ACL deny（nft 真相源）：命中即丢，先于限速/放行
    tcp dport $FORWARD_TCP_PORTS ip saddr $ACL_DENY counter drop comment "acl-deny-tcp"
    udp dport $FORWARD_UDP_PORTS ip saddr $ACL_DENY counter drop comment "acl-deny-udp"
    # ACL allow：allow 非空时渲染为严格名单；空时 ACL_ALLOW=0.0.0.0/0，下列规则不生效
    tcp dport $FORWARD_TCP_PORTS ip saddr != $ACL_ALLOW counter drop comment "acl-allow-miss-tcp"
    udp dport $FORWARD_UDP_PORTS ip saddr != $ACL_ALLOW counter drop comment "acl-allow-miss-udp"

    # 转发 TCP 入口（rules 监听端口）+ 新建连接限速
    # （已建立会话在上方 established,related 已放行；长连接勿再对整会话做 PPS）
    tcp dport $FORWARD_TCP_PORTS jump allow-forward-tcp
    # 转发 UDP 入口（rules 监听端口）+ 每 IP PPS 限速
    udp dport $FORWARD_UDP_PORTS jump allow-forward-udp

    # 管理面仅本机（host network 下由服务本身 bind 127.0.0.1）
    # 若误暴露，这里再拒绝一次公网访问
    tcp dport { 3000, 9090, 9100, 9901 } ip saddr != 127.0.0.1 drop comment "deny-public-mgmt"
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }

  chain allow-forward-tcp {
    # 每源 IP 新建连接限速（nft 1.0.x：dynamic set + 内联 rate/burst）
    ct state new ip saddr @tcp_new_per_ip limit rate over @INLINE_TCP_NEW_CONN_RATE@ burst @INLINE_TCP_NEW_CONN_BURST@ packets counter drop comment "limit-new-tcp"
    accept comment "allow-forward-tcp"
  }

  chain allow-forward-udp {
    # 每源 IP UDP PPS 限速（防扫描/小流量洪泛；大流量仍需高防）
    ip saddr @udp_pps_per_ip limit rate over @INLINE_UDP_PPS_RATE@ burst @INLINE_UDP_PPS_BURST@ packets counter drop comment "limit-udp-pps"
    accept comment "allow-forward-udp"
  }
}
