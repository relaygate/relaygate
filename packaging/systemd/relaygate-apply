#!/usr/bin/env bash
# Root-owned privileged helper for Panel Apply (relaygate reload via Docker).
# Installed to /usr/local/libexec/relaygate/apply (root:root 0755).
# Invoked only via sudoers whitelist from user relaygate; never writable by that user.
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  echo "ERROR: relaygate-apply must run as root" >&2
  exit 1
fi

# Clear so nested reload does not re-exec sudo (avoid recursion).
unset RELAYGATE_PRIVILEGED_HELPER

INSTALL_DIR="${RELAYGATE_INSTALL_DIR:-/opt/relaygate}"
BIN="${INSTALL_DIR}/bin/relaygate"

if [[ ! -x "$BIN" ]]; then
  echo "ERROR: missing $BIN" >&2
  exit 1
fi

cd "$INSTALL_DIR"
exec "$BIN" reload "$@"
