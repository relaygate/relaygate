# 节点组件（node）示例 — 复制到该主机仓库/安装根目录为 .env
# cp packaging/node/env.example .env && chmod 600 .env
#
# 节点：agent + 本机热更新控制 + Envoy；无完整 Panel。
# 配置由主控发布后，本机 agent 拉取并对齐。
# GATEWAY_NAME 建议 gateway-02 起编（两位序号），与主控本机 gateway-01 区分。

GATEWAY_NAME=gateway-02
GATEWAY_PUBLIC_IP=203.0.113.20
GATEWAY_SSH_PORT=22

# 节点不启 Panel；standby 仅作误启时的写保护兜底
PANEL_ROLE=standby
ENABLE_PANEL=0
COMPOSE_PROJECT_NAME=relaygate-gateway-02
# 空 = 仅 envoy + prometheus + node_exporter；边缘日志用 with-logs
COMPOSE_PROFILES=with-logs

# 主控地址（节点 Agent 拉取 / 心跳）
PRIMARY_URL=http://203.0.113.10:9000
# 接入时发放的令牌文件（权限 600）；勿写入 Git
AGENT_TOKEN_FILE=/etc/relaygate/secrets/agent.token

ENVOY_IMAGE=envoyproxy/envoy:v1.39.0
ENVOY_ADMIN_PORT=9901
ENVOY_CONCURRENCY=0

# 本机热更新（默认开；由 agent run 内嵌）
XDS_ENABLED=1

IMAGE_TAG=local

# 无 Panel/Grafana 时密码仅占位；生产勿依赖 .env 明文
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=unused-on-node
PANEL_ADMIN_PASSWORD=unused-on-node
PANEL_BIND=0.0.0.0:9000
GRAFANA_URL=

PROMETHEUS_RETENTION=7d
# PROMETHEUS_REMOTE_WRITE_URL=http://prometheus.internal:9090/api/v1/write

# 边缘日志采集 → 中心 Loki（勿对公网暴露 3100）
# LOKI_HOST=10.0.0.1
# LOKI_PORT=3100
PROXY_PROTOCOL=off
# LOG_SAMPLE_RATE=1.0
# LOG_SHORT_SESSION_MS=2000
