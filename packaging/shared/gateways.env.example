# 运维机 / CI 使用的网关 inventory（seed 到 DataDir/inventory/gateways.env）
# 由 relaygate setup 复制；勿放进源码树顶层 data/
# 勿写入 SSH 私钥或密码；灌钥见 packaging/scripts/push-fleet-key.sh（P0）。
#
# 角色约定（与各机 .env 对齐，非本文件字段）：
#   gateway-01 = Management Primary：ENABLE_PANEL=1 PANEL_ROLE=primary
#   gateway-02+ = Secondary 数据面：ENABLE_PANEL=0（瘦 xDS，勿每台完整 Panel / D13）
#   若误启 Panel：PANEL_ROLE=standby 拒写（D6）

GATEWAY_MATRIX=gateway-01,gateway-02

# gateway-01（Management Primary：完整 Panel + 本机 ADS）
HOST_gateway_01=203.0.113.10
SSH_PORT_gateway_01=22
SSH_USER_gateway_01=root
REMOTE_DIR_gateway_01=/opt/relaygate

# gateway-02（Secondary 数据面：Envoy + 瘦 xDS + with-logs；无完整 Panel）
HOST_gateway_02=203.0.113.20
SSH_PORT_gateway_02=22
SSH_USER_gateway_02=root
REMOTE_DIR_gateway_02=/opt/relaygate

# 分批同步必须用不可变 ref（tag 或 commit SHA）；默认读仓库 RELEASE
# DEPLOY_REF=v0.1.0
