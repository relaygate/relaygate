# 复制为服务器上的 .env（权限 600），不要提交真实密码
# cp packaging/shared/env.example .env && chmod 600 .env
#
# 多机部署：主控用 packaging/control/env.example，网关节点用 packaging/node/env.example。
# 同一套 packaging/compose.yaml 可复用；日常运维用 relaygate CLI。
# 运行态：开发默认 <repo>/.runtime；安装默认 $INSTALL_DIR/data。
# setup 会写入绝对路径 RELAYGATE_DATA_DIR=…（compose 挂载依赖此变量）。

# --- 本机节点身份（必填，驱动容器名 / Envoy node / Prometheus 标签）---
GATEWAY_NAME=gateway-01
GATEWAY_PUBLIC_IP=203.0.113.10
# SSH 端口：安装/配置时指定，默认 22
GATEWAY_SSH_PORT=22

# --- Panel / 观测 ---
# primary=可写主控；standby=写保护（拒绝 API/表单写）；网关节点请 PANEL_ENABLED=0
PANEL_ROLE=primary
# 主控=1（宿主二进制 + systemd relaygate-panel）；节点=0
PANEL_ENABLED=1
# 默认对外 :9000；仅本机访问可改 PANEL_BIND=127.0.0.1:9000
PANEL_BIND=0.0.0.0:9000
# 主控默认开 Grafana
GRAFANA_ENABLED=1

# --- 安装 / 路径 / 版本 ---
RELAYGATE_SECRETS_DIR=/etc/relaygate/secrets
# RELAYGATE_DATA_DIR=…   # setup 写入；compose 挂载依赖此变量
IMAGE_TAG=local

# --- Compose / 数据面 ---
COMPOSE_PROJECT_NAME=relaygate-gateway-01
# 角色 profile：control（主控全开）或 node（Alloy 指标上报）
COMPOSE_PROFILES=control
ENVOY_IMAGE=envoyproxy/envoy:v1.39.0
ENVOY_ADMIN_PORT=9901
# 0 = Envoy 自动按 CPU 核数设置 worker
ENVOY_CONCURRENCY=0
# 本机热更新（默认开；日常 Apply / reload 走 CDS+LDS，无需重启 Envoy）
XDS_ENABLED=1
# XDS_PORT=18000

# --- 机群连接（仅节点需要；主控可省略）---
# CONTROL_URL=http://203.0.113.10:9000
# AGENT_TOKEN_FILE=/etc/relaygate/secrets/agent.token

# --- 安全落地（分层，勿混用）---
# APPLY_FIREWALL=1          # 安装/CLI 一次性应用防火墙
# SECURITY_AUTO_APPLY=0     # 节点 agent 拉取后自动应用主机侧；主控默认关

# --- Grafana / Panel 密码 ---
# 以下供本地开发；一键安装用 RELAYGATE_SECRETS_DIR 下的文件。
# grafana_admin_password 须 0640（Grafana 容器 gid=0 可读；勿用 0600）。
# 默认密码弱，生产务必修改。
GRAFANA_ADMIN_USER=admin
# 本地开发可设 PANEL_ADMIN_PASSWORD；生产用 PANEL_ADMIN_PASSWORD_FILE（systemd）
PANEL_ADMIN_PASSWORD=relaygate
# Grafana 仅经 Panel 同源反代（/grafana/、/monitoring）。
# 置空 GRAFANA_URL= 可关闭反代。Panel 仅接受 loopback 的 http(s) URL。
GRAFANA_URL=http://127.0.0.1:3000
# root_url 用相对子路径，便于 SSH 隧道（浏览器 origin 为 localhost:9000）。
# 勿用含 Grafana 自身 :3000 的官方模板作默认，经 Panel 反代时会链到不可达端口。
GRAFANA_ROOT_URL=/grafana/
GRAFANA_ANONYMOUS=true

# L4 友好变更：reload / drain fail 等待 LB 摘流窗口（秒）。
# 与 packaging/terraform/nlb 默认 HC 对齐：unhealthy_threshold(3) × interval(10s) = 30。
# 若自建 NLB 改了 threshold/interval，请同步调大本值（建议 ≥ 乘积）。
DRAIN_WAIT=30

# --- 真实客户端 IP / PROXY Protocol（默认 off = 公网直连暴露）---
# 本产品主路径：客户端直连网关端口；多上游由网关转发，前面没有云 LB → 保持 off。
# 「多个上游」≠ 需要 PROXY；PROXY 只与「客户端→网关前是否有会发 PROXY 头的 LB」有关。
#
# 取值：
#   off（默认）     — 无 PROXY filter；downstream = TCP peer（直连正确）
#   v2 / on         — 强制 PROXY v2 头（仅当 LB 已开 PROXY，且转发口只对 LB 网段开放）
#   v2-compat       — 无头用 peer，有头用头内 IP（= v2 + ALLOW_WITHOUT=1）
#
# 【禁止】公网直连开 v2 / v2-compat：任意客户端可伪造 PROXY 头污染 access log / ACL。
# 详见 docs/logging-playbook.md
PROXY_PROTOCOL=off
# PROXY_PROTOCOL_ALLOW_WITHOUT=0
# 仅 LB 可信网段入口时才考虑：PROXY_PROTOCOL=v2-compat  或  PROXY_PROTOCOL=v2 + PROXY_PROTOCOL_ALLOW_WITHOUT=1

# --- TCP access 日志（主控 Alloy → Loki）---
# ALLOY_CONFIG_FILE=config.alloy
# LOKI_HOST=127.0.0.1
# LOKI_PORT=3100
# LOKI_IMAGE=grafana/loki:3.5.0
# ALLOY_IMAGE=grafana/alloy:v1.9.2
# 保留期与 packaging/loki/loki-config.yml retention_period 对齐（改配置后重启 Loki）
# LOKI_RETENTION_PERIOD=168h
# 采样：1.0=全量；<1 时仅对「正常」长会话抽样；flags≠- 与短会话始终保留
# LOG_SAMPLE_RATE=1.0
PROMETHEUS_RETENTION=15d
# 节点：Alloy remote_write 到主控（install/setup 会预写）
# PROMETHEUS_REMOTE_WRITE_URL=http://203.0.113.10:9000/api/agent/metrics/write
# 主控告警：Alertmanager 随 control；外发见 packaging/alertmanager/alertmanager.yml
# ALERTMANAGER_URL=http://127.0.0.1:9093
