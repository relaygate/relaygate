# 主控组件（control）示例 — 复制到该主机仓库/安装根目录为 .env
# cp packaging/control/env.example .env && chmod 600 .env
# 然后替换密码与公网 IP；生产密码请从密钥管理注入。
#
# 主控：Panel UI + 意图/发布/节点名册；可选本机转发（Compose Envoy）。
# GATEWAY_NAME 是本机 Envoy 身份（常用 gateway-01），不是「可 fleet leave 的名册成员」。
# 机群名册里的网关节点用 fleet join（示例 gateway-02、gateway-03…）。

# --- 本机节点身份 ---
GATEWAY_NAME=gateway-01
GATEWAY_PUBLIC_IP=203.0.113.10
# SSH 端口：安装/配置时指定，默认 22（仅装机引导；不进正式产品菜单）
GATEWAY_SSH_PORT=22

# --- Panel / 观测 ---
# primary = 可写 Panel（systemd）；须与 PANEL_ENABLED=1 一起用于主控
PANEL_ROLE=primary
PANEL_ENABLED=1
# 默认对外 :9000；仅本机访问可改 PANEL_BIND=127.0.0.1:9000
PANEL_BIND=0.0.0.0:9000
# 是否启 Compose with-grafana（主控默认开；也可只靠 COMPOSE_PROFILES）
GRAFANA_ENABLED=1

# --- 安装 / 路径 / 版本（可选；setup 常写入绝对路径）---
# RELAYGATE_DATA_DIR=/opt/relaygate/data
RELAYGATE_SECRETS_DIR=/etc/relaygate/secrets
IMAGE_TAG=local

# --- Compose / 数据面 ---
COMPOSE_PROJECT_NAME=relaygate-gateway-01
COMPOSE_PROFILES=with-grafana,with-loki,with-logs
ENVOY_IMAGE=envoyproxy/envoy:v1.39.0
ENVOY_ADMIN_PORT=9901
ENVOY_CONCURRENCY=0
# 本机热更新（默认开）
XDS_ENABLED=1

# --- 安全落地（分层）---
# APPLY_FIREWALL=1          # 仅安装/CLI 一次性应用防火墙（非运行时自动）
# SECURITY_AUTO_APPLY：节点 agent 拉取后是否自动应用主机侧（内核+防火墙）
# 主控（PANEL_ENABLED=1）默认关闭；勿在生产主控设 =1，除非明确要改本机防火墙/内核
# SECURITY_AUTO_APPLY=0

# --- Grafana / Panel 密码 ---
# 一键安装会改用 /etc/relaygate/secrets 下的文件；以下仅用于旧部署兼容 / 本地开发。
# 默认密码弱，生产务必修改。grafana_admin_password 须 0640（容器 gid=0 可读）。
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=relaygate
PANEL_ADMIN_PASSWORD=relaygate
# Grafana 经 Panel 反代（唯一管理出口）；网关节点勿设或置空
GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_ROOT_URL=/grafana/
GRAFANA_ANONYMOUS=true

# --- PROXY Protocol（默认 off：公网直连暴露）---
PROXY_PROTOCOL=off
# 前面有云 LB 且发 PROXY v2、端口仅对 LB：PROXY_PROTOCOL=v2
# 迁移兼容（入口必须仅信任 LB，公网禁止）：PROXY_PROTOCOL=v2-compat

# --- TCP access 日志（Fluent Bit → Loki）---
# 主控：上列 profiles 含 with-loki,with-logs；网关节点：COMPOSE_PROFILES=with-logs
# LOKI_HOST=127.0.0.1
# LOKI_PORT=3100
# LOKI_IMAGE=grafana/loki:3.5.0
# FLUENT_BIT_IMAGE=fluent/fluent-bit:3.2.10
# LOKI_RETENTION_PERIOD=168h
# LOG_SAMPLE_RATE=1.0
# LOG_SHORT_SESSION_MS=2000
PROMETHEUS_RETENTION=15d
# PROMETHEUS_REMOTE_WRITE_URL=http://prometheus.internal:9090/api/v1/write
