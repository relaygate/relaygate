// RelayGate：Alloy 采集 Envoy TCP access → 中心 Loki（Compose profile with-logs）
// 替代原 Fluent Bit 路径；指标仍由本机 Prometheus（with-metrics）负责。
//
// 采样：默认全量保留（与 LOG_SAMPLE_RATE=1.0 一致）。
// Alloy stage.match 不支持 | json 管道，故未在 River 内复刻「异常/短会话优先」Lua 逻辑；
// 降采样请在 Loki 查询侧过滤 flags/duration，或后续再加独立 process 组件。

logging {
	level  = "info"
	format = "logfmt"
}

local.file_match "envoy_tcp" {
	path_targets = [{
		__path__ = "/var/log/envoy/tcp-access.json",
	}]
}

loki.source.file "envoy_tcp" {
	targets    = local.file_match.envoy_tcp.targets
	forward_to = [loki.process.tcp_access.receiver]
}

loki.process "tcp_access" {
	forward_to = [loki.write.control.receiver]

	stage.static_labels {
		values = {
			job     = "envoy-tcp-access",
			gateway = env("GATEWAY_NAME"),
		}
	}
}

loki.write "control" {
	endpoint {
		url = format(
			"http://%s:%s/loki/api/v1/push",
			coalesce(env("LOKI_HOST"), "127.0.0.1"),
			coalesce(env("LOKI_PORT"), "3100"),
		)
	}
}
