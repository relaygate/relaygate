# 运维机 / CI 使用的网关 inventory（seed 到 data/inventory/gateways.env）
# cp gateways.env.example data/inventory/gateways.env

GATEWAY_MATRIX=gateway-01,gateway-02

# gateway-01（主管理节点，跑 Panel）
HOST_gateway_01=203.0.113.10
SSH_PORT_gateway_01=22
SSH_USER_gateway_01=root
REMOTE_DIR_gateway_01=/opt/relaygate

# gateway-02（双活数据面）
HOST_gateway_02=203.0.113.20
SSH_PORT_gateway_02=22
SSH_USER_gateway_02=root
REMOTE_DIR_gateway_02=/opt/relaygate

# 分批同步必须用不可变 ref（tag 或 commit SHA）；默认读仓库 RELEASE
# DEPLOY_REF=v0.1.0
