.env
.env.*
!.env.example
!deploy/env/*.env.example
!deploy/monitoring/.env.central.example

# 真实业务资产（含后端真实 IP/端口，敏感）——仅示例模板入库
config/resources.yaml

# 渲染产物（由 relaygate render 生成，含真实后端地址，敏感）——不入库
gateway/generated/
deploy/firewall/generated/
bin/
.tools/
backups/
docs/BASELINE.runtime.txt
*.log
.DS_Store
Thumbs.db
__pycache__/
*.pyc
.venv/
venv/
*.exe

# Terraform local state / secrets
deploy/terraform/**/.terraform/
deploy/terraform/**/*.tfstate
deploy/terraform/**/*.tfstate.*
deploy/terraform/**/terraform.tfvars
deploy/terraform/**/crash.log

# Local inventory (may contain hosts)
deploy/inventory/gateways.env
deploy/firewall/.gateway-*.nft
