# RelayGate — 开发/构建忽略规则
# 预设配置入库（*.example、core/deploy/）；运行态不入库（data/、.env）

# 构建与发布产物
/bin/
/dist/
*.exe

# 运行态（setup/render/apply 写入）
/data/

# 本地环境文件（模板：根 .env.example、以及 core/deploy/**/.env.example）
.env
.env.*
!.env.example
!**/.env.example

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# 日志与工具缓存
*.log
.tools/

# Terraform 本地状态
**/.terraform/
*.tfstate
*.tfstate.*
