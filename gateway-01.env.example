# gateway-01 主管理节点示例（复制到该主机仓库根目录为 .env）
# cp gateway-01.env.example .env && chmod 600 .env
# 然后替换密码与公网 IP；生产密码请从密钥管理注入。
#
# Panel：宿主二进制 + systemd（relaygate-panel），不在 Compose 中。
# 数据面：Compose；Grafana 用 with-grafana。

GATEWAY_NAME=gateway-01
GATEWAY_PUBLIC_IP=203.0.113.10
# SSH 端口：安装/配置时指定，默认 22
GATEWAY_SSH_PORT=22
# primary = 可写 Panel（systemd）；须与 ENABLE_PANEL=1 一起用于主管理节点
PANEL_ROLE=primary
ENABLE_PANEL=1
COMPOSE_PROJECT_NAME=relaygate-gateway-01
COMPOSE_PROFILES=with-grafana,with-loki,with-logs

ENVOY_IMAGE=envoyproxy/envoy:v1.39.0
ENVOY_ADMIN_PORT=9901
ENVOY_CONCURRENCY=0

IMAGE_TAG=local

GRAFANA_ADMIN_USER=admin
# 一键安装会改用 /etc/relaygate/secrets 下的文件；以下仅用于旧部署兼容。
# grafana_admin_password 须 0640（容器 gid=0 可读）。
RELAYGATE_SECRETS_DIR=/etc/relaygate/secrets
GRAFANA_ADMIN_PASSWORD=change-me-strong-password
PANEL_ADMIN_PASSWORD=change-me-panel-password
# 默认对外 :9000；仅本机访问可改 PANEL_BIND=127.0.0.1:9000
PANEL_BIND=0.0.0.0:9000

# Grafana 经 Panel 反代（唯一管理出口）；从节点勿设或置空
GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_ROOT_URL=/grafana/
GRAFANA_ANONYMOUS=true

# PROXY Protocol（默认 off：公网直连暴露；见 docs/logging-playbook.md）
PROXY_PROTOCOL=off
# 前面有云 LB 且发 PROXY v2、端口仅对 LB：PROXY_PROTOCOL=v2
# 迁移兼容（入口必须仅信任 LB，公网禁止）：PROXY_PROTOCOL=v2-compat

# --- TCP access 日志（Fluent Bit → Loki）见 docs/logging-playbook.md ---
# 主节点：上列 profiles 含 with-loki,with-logs；从节点：COMPOSE_PROFILES=with-logs
# LOKI_HOST=127.0.0.1
# LOKI_PORT=3100
# LOKI_IMAGE=grafana/loki:3.5.0
# FLUENT_BIT_IMAGE=fluent/fluent-bit:3.2.10
# 保留期与 packaging/loki/loki-config.yml retention_period 对齐（改配置后重启 Loki）
# LOKI_RETENTION_PERIOD=168h
# P2 采样：1.0=全量；<1 时仅对「正常」会话抽样；flags≠- 与短会话始终保留
# LOG_SAMPLE_RATE=1.0
# LOG_SHORT_SESSION_MS=2000
PROMETHEUS_RETENTION=15d
# PROMETHEUS_REMOTE_WRITE_URL=http://prometheus.internal:9090/api/v1/write
